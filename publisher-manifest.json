;padding-top:6px;margin-bottom:14px}\nh2{font-size:44px;line-height:1.25;color:var(--ink);font-weight:800;letter-spacing:-.01em;margin-bottom:14px}\nh2 .num{font-family:Georgia,serif;font-style:italic;color:var(--bar);margin-right:14px;font-weight:400;font-size:36px;display:inline-block;width:60px}\n.lead{font-size:19px;color:var(--ink2);max-width:780px;margin-bottom:30px}\n\n/* story: 专栏叙述 */\n.story{columns:2;column-gap:42px;font-size:17px;color:var(--ink)}\n.story p{margin-bottom:18px}\n.story p:first-child::first-letter{font-family:\"Songti SC\",serif;font-size:64px;float:left;line-height:.9;padding:6px 10px 0 0;color:var(--bar);font-weight:900}\n.story blockquote{border-left:3px solid var(--bar);padding:6px 0 6px 18px;color:var(--ink);font-style:italic;margin:18px 0;break-inside:avoid}\n\n/* 章节目录条 */\n.tocbar{display:flex;flex-wrap:wrap;gap:0;border:1px solid var(--ink);background:var(--soft);margin-top:36px}\n.tocbar a{flex:1 1 auto;border:none;border-right:1px solid var(--ink);padding:18px 18px;font-size:13px;color:var(--ink);text-align:center;letter-spacing:.2em;text-transform:uppercase}\n.tocbar a:last-child{border-right:none}\n.tocbar a b{display:block;font-size:18px;letter-spacing:.05em;color:var(--bar);font-family:Georgia,serif;text-transform:none;font-style:italic;margin-bottom:4px;font-weight:400}\n\n/* 客户群 */\n.clients{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--ink);border-left:1px solid var(--ink);background:var(--soft)}\n.client{border-right:1px solid var(--ink);border-bottom:1px solid var(--ink);padding:24px;background:var(--cream)}\n.client h4{font-size:13px;letter-spacing:.35em;color:var(--bar);text-transform:uppercase;margin-bottom:10px}\n.client p{font-size:15.5px;color:var(--ink);line-height:1.75}\n.client .badge{display:inline-block;background:var(--bar);color:var(--cream);padding:3px 9px;font-size:11px;letter-spacing:.3em;margin-bottom:10px}\n\n/* 卡片：左侧色条 */\n.cards{display:grid;grid-template-columns:re